---
import Logo from '../shared/Logo.astro';
import { COMMUNITY_URL, DISTRIBUTION, DOWNLOAD_URL, SPONSORS_URL } from '../../consts';
import { getCopy, localizedPath, SHARED_COPY, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const shared = SHARED_COPY[locale];
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface-soft">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <div class="mb-3 flex items-center gap-2 text-text">
        <Logo size="sm" />
        <span class="text-sm font-semibold tracking-tight">Amonite</span>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-text-muted">
        {copy.footer.independent}
        {` ${DISTRIBUTION.series} ${copy.common.alpha} ${copy.footer.available}`}
      </p>
    </div>

    <div>
      <p class="label-mono font-medium text-accent">{copy.footer.project}</p>
      <ul class="mt-3 space-y-0.5 text-sm text-text-muted">
        <li><a href={localizedPath(locale, 'philosophy')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.nav.philosophy}</a></li>
        <li><a href={localizedPath(locale, 'engineering')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.nav.engineering}</a></li>
        <li><a href={localizedPath(locale, 'gallery')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.nav.gallery}</a></li>
        <li><a href={localizedPath(locale, 'community')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.nav.community}</a></li>
      </ul>
    </div>

    <div>
      <p class="label-mono font-medium text-accent">{copy.footer.getStarted}</p>
      <ul class="mt-3 space-y-0.5 text-sm text-text-muted">
        <li><a href={localizedPath(locale, 'downloads')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.nav.downloads}</a></li>
        <li><a href={DOWNLOAD_URL} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.footer.releases}</a></li>
        <li><a href={COMMUNITY_URL} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.footer.community}</a></li>
        <li><a href={SPONSORS_URL} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.footer.sponsors}</a></li>
      </ul>
    </div>

    <div>
      <p class="label-mono font-medium text-accent">{copy.footer.legal}</p>
      <ul class="mt-3 space-y-0.5 text-sm text-text-muted">
        <li><a href={localizedPath(locale, 'privacy')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.footer.privacy}</a></li>
        <li><a href={localizedPath(locale, 'terms')} class="inline-flex min-h-11 items-center transition-colors hover:text-text">{copy.footer.terms}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-5 text-xs text-text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Manuel Gil. {shared.copyright}</p>
      <p>{copy.footer.screenshots}</p>
    </div>
  </div>
</footer>
