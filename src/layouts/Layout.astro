---
import '../styles/global.css';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import BaseHead from '../components/BaseHead.astro';
import StructuredData from '../components/StructuredData.astro';
import { AUTHOR_JSONLD, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCopy, getLocale, type Locale } from '../i18n';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  structuredData?: Record<string, unknown>[];
  locale?: Locale;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  structuredData = [],
  locale: localeProp,
} = Astro.props;
const locale = getLocale(localeProp ?? Astro.currentLocale);
const copy = getCopy(locale);
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: Astro.site?.toString(),
  description,
  inLanguage: locale,
  publisher: AUTHOR_JSONLD,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      (() => {
        try {
          const preference = localStorage.getItem('amonite-theme');
          if (preference === 'light' || preference === 'dark') {
            document.documentElement.dataset.theme = preference;
          }
        } catch {
          // System appearance remains the safe default when storage is unavailable.
        }
      })();
    </script>
    <BaseHead
      title={pageTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      locale={locale}
    />
    <StructuredData item={websiteSchema} />
    {structuredData.map((item) => <StructuredData item={item} />)}
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-text">
    <a
      href="#main"
      class="sr-only rounded-default bg-surface px-4 py-3 text-sm font-medium text-text shadow-sm focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      {copy.skipToContent}
    </a>
    <SiteNav locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
