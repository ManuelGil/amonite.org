---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ActionLink from '../components/site/ActionLink.astro';
import CapabilityIndex from '../components/site/CapabilityIndex.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Screenshot from '../components/site/Screenshot.astro';
import terminalFastfetch from '../assets/screenshots/terminal-fastfetch.png';
import installerPartitions from '../assets/screenshots/installer-partitions.png';
import engineeringImage from '../assets/img/engineering.jpg';
import { DISTRIBUTION } from '../consts';
import { formatCopy, getCopy, getLocale, localizedPath, MEDIA_COPY, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const engineering = copy.engineering;
const media = MEDIA_COPY[locale];
const stage = copy.common.alpha;
const composition = [
  { part: engineering.platform, choice: DISTRIBUTION.platform },
  { part: engineering.desktop, choice: DISTRIBUTION.desktop },
  { part: engineering.terminal, choice: DISTRIBUTION.terminal },
  { part: engineering.installer, choice: DISTRIBUTION.installer },
];
---

<Layout
  locale={locale}
  title={copy.meta.engineering.title}
  description={copy.meta.engineering.description}
  image={terminalFastfetch}
>
  <PageHeader
    eyebrow={engineering.eyebrow}
    title={engineering.heading}
    lead={engineering.lead}
  />

  <article class="mx-auto max-w-6xl space-y-20 px-6 py-16 sm:space-y-24 sm:py-20">
    <section class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-14">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {engineering.protagonistHeading}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {engineering.protagonistBody}
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {engineering.compositionBody}
        </p>
      </div>
      <div>
        <p class="label-mono mb-3 font-medium text-accent">{engineering.standardEdition}</p>
        <table class="w-full border-t border-border text-sm">
          <caption class="sr-only">{engineering.compositionCaption}</caption>
          <tbody>
            {
              composition.map((row) => (
                <tr class="border-b border-border">
                  <th
                    scope="row"
                    class="py-3 pr-6 text-left font-normal text-text-muted"
                  >
                    {row.part}
                  </th>
                  <td class="py-3 text-right font-mono text-[0.8125rem] text-text">
                    {row.choice}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-3 text-xs leading-relaxed text-text-muted">
          {engineering.defaultsNote}
        </p>
      </div>
    </section>

    <section class="grid gap-8 border-y border-border py-10 sm:grid-cols-[1.15fr_0.85fr] sm:items-center sm:gap-12">
      <Image
        src={engineeringImage}
        alt={media.engineeringWatchAlt}
        class="h-56 w-full object-cover sm:h-64"
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(max-width: 640px) 100vw, 65vw"
        quality={82}
        format="webp"
      />
      <div>
        <p class="label-mono font-medium text-accent">{engineering.compositionEyebrow}</p>
        <p class="mt-3 text-lg leading-relaxed text-text">
          {engineering.compositionHeading}
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
        {engineering.capabilityHeading}
      </h2>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">
        {formatCopy(engineering.capabilityLead, {
          series: DISTRIBUTION.series,
          stage,
        })}
      </p>
      <CapabilityIndex showVia locale={locale} class="mt-10" />
    </section>

    <section class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <Screenshot
        image={terminalFastfetch}
        alt={media.engineeringTerminalAlt}
          caption={formatCopy(engineering.commandClosing, {
            name: DISTRIBUTION.name,
            release: DISTRIBUTION.release,
          })}
        sizes="(max-width: 1024px) 100vw, 36rem"
      />
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {engineering.commandHeading}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {copy.product.cliSummary}
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {engineering.commandBody}
        </p>
      </div>
    </section>

    <section class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <div class="lg:order-2">
        <Screenshot
          image={installerPartitions}
          alt={media.engineeringInstallerAlt}
          caption={media.engineeringInstallerCaption}
          sizes="(max-width: 1024px) 100vw, 36rem"
        />
      </div>
      <div class="lg:order-1">
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {engineering.installationHeading}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {engineering.installationBody}
        </p>
        <p class="mt-6">
          <ActionLink href={localizedPath(locale, 'gallery')} variant="ghost">
            {engineering.installationClosing}
          </ActionLink>
        </p>
      </div>
    </section>

    <section class="border-t border-border pt-10">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-center">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-text">
            {formatCopy(engineering.seriesHeading, {
              series: DISTRIBUTION.series,
              stage,
            })}
          </h2>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-text-muted">
            {engineering.seriesBody}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <ActionLink href={localizedPath(locale, 'downloads')}>{engineering.downloads}</ActionLink>
          <ActionLink href={localizedPath(locale, 'philosophy')} variant="secondary">{engineering.philosophy}</ActionLink>
        </div>
      </div>
    </section>
  </article>
</Layout>
