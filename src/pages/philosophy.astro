---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ActionLink from '../components/site/ActionLink.astro';
import PageHeader from '../components/site/PageHeader.astro';
import philosophyImage from '../assets/img/philosophy.jpg';
import { getCopy, getLocale, localizedPath, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const philosophy = copy.philosophy;
const principles = philosophy.principles;
---

<Layout
  locale={locale}
  title={copy.meta.philosophy.title}
  description={copy.meta.philosophy.description}
>
  <PageHeader
    eyebrow={philosophy.eyebrow}
    title={philosophy.heading}
    lead={philosophy.lead}
  />

  <article class="mx-auto max-w-6xl space-y-20 px-6 py-16 sm:space-y-24 sm:py-20">
    <section class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      <figure>
        <Image
          src={philosophyImage}
          alt={philosophy.imageAlt}
          class="aspect-[4/3] w-full object-cover"
          width={1200}
          widths={[480, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 32rem"
          quality={82}
          format="webp"
        />
        <figcaption class="mt-3 text-xs leading-relaxed text-text-muted">
          {philosophy.imageCaption}
        </figcaption>
      </figure>
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {philosophy.whyHeading}
        </h2>
        <p class="display-serif border-l-2 border-accent pl-6 text-xl leading-relaxed text-text sm:text-2xl">
          {copy.product.selectionPrinciple}
        </p>
        <p class="mt-8 text-base leading-relaxed text-text-muted">
          {philosophy.frictionBody}
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {philosophy.ownershipBody}
        </p>
      </div>
    </section>

    <section>
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {philosophy.differenceHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {philosophy.differenceLead}
        </p>
      </div>
      <div class="mt-10 grid gap-10 border-t border-border pt-8 md:grid-cols-3 md:gap-8">
        {
          principles.map((principle, i) => (
            <div>
              <span class="font-mono text-sm text-text-muted/60" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 text-base font-semibold tracking-tight text-text">
                {principle.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{principle.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-16">
      <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
        {philosophy.limitsHeading}
      </h2>
      <div class="max-w-2xl">
        <p class="text-base leading-relaxed text-text-muted">
          {philosophy.limitsBody}
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {philosophy.limitsClosing}
        </p>
      </div>
    </section>

    <section class="border-t border-border pt-10">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-10">
        <div>
          <h2 class="text-lg font-semibold text-text">{philosophy.nextHeading}</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            {philosophy.nextBody}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <ActionLink href={localizedPath(locale, 'engineering')}>{philosophy.engineering}</ActionLink>
          <ActionLink href={localizedPath(locale, 'downloads')} variant="secondary">{philosophy.downloads}</ActionLink>
        </div>
      </div>
    </section>
  </article>
</Layout>
