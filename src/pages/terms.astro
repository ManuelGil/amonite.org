---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import { SITE_AUTHOR } from '../consts';
import { getCopy, getLocale, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const terms = copy.legal.terms;
---

<Layout
  locale={locale}
  title={terms.title}
  description={terms.description}
>
  <PageHeader eyebrow={terms.eyebrow} title={terms.title} />
  <article class="mx-auto max-w-2xl px-6 py-16 sm:py-20">
    <div class="space-y-6 text-base leading-relaxed text-text-muted">
      {terms.paragraphs.map((paragraph, index) => (
        <p>{index === 2 ? `${paragraph.split(SITE_AUTHOR)[0]}${SITE_AUTHOR}.` : paragraph}</p>
      ))}
    </div>
  </article>
</Layout>
