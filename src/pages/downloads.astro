---
import Layout from '../layouts/Layout.astro';
import ActionLink from '../components/site/ActionLink.astro';
import PageHeader from '../components/site/PageHeader.astro';
import { DISTRIBUTION, PUBLIC_EDITIONS, SOFTWARE_APPLICATION_JSONLD } from '../consts';
import {
  LOCALE_CODES,
  formatCopy,
  getCopy,
  getEditionCopy,
  getLocale,
  getReleaseCopy,
  localizedPath,
  SHARED_COPY,
  type Locale,
} from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const shared = SHARED_COPY[locale];
const downloads = copy.downloads;
const defaultReleaseCopy = getReleaseCopy(
  locale,
  DISTRIBUTION.editionId,
  DISTRIBUTION.release,
);
const { validatedConfiguration } = DISTRIBUTION;
const { artifacts } = DISTRIBUTION;

const configuration = [
  { label: copy.product.validated.architecture, value: validatedConfiguration.architecture },
  { label: copy.product.validated.cpu, value: validatedConfiguration.cpu },
  { label: copy.product.validated.memory, value: validatedConfiguration.memory },
  { label: copy.product.validated.storage, value: validatedConfiguration.storage },
  { label: copy.product.validated.firmware, value: validatedConfiguration.firmware },
  { label: copy.product.validated.virtualization, value: validatedConfiguration.virtualization },
  { label: copy.product.validated.installedSize, value: validatedConfiguration.installedSize },
];

const editionsWithHistory = PUBLIC_EDITIONS.filter(
  (edition) => edition.releaseHistory.length > 0,
);

/** Localized publication date from Publication.publishedAt (UTC calendar day). */
function formatPublicationDate(isoDate: string): string {
  return new Intl.DateTimeFormat(LOCALE_CODES[locale], {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${isoDate}T00:00:00Z`));
}

function formatIsoSize(sizeBytes: number | null): string | null {
  return sizeBytes !== null ? new Intl.NumberFormat(LOCALE_CODES[locale]).format(sizeBytes) : null;
}
---

<Layout
  locale={locale}
  title={copy.meta.downloads.title}
  description={copy.meta.downloads.description}
  structuredData={[
    {
      ...SOFTWARE_APPLICATION_JSONLD,
      description: copy.meta.downloads.description,
      inLanguage: locale,
    },
  ]}
>
  <PageHeader
    eyebrow={downloads.eyebrow}
    title={downloads.heading}
    lead={downloads.lead}
  />

  <article class="mx-auto max-w-6xl space-y-20 px-6 py-16 sm:space-y-24 sm:py-20">
    {
      PUBLIC_EDITIONS.map((edition) => {
        const release = edition.currentRelease;
        const releaseCopy = release
          ? getReleaseCopy(locale, edition.id, release.version)
          : null;
        const editionCopy = getEditionCopy(locale, edition.id);
        const statusLabel =
          edition.status === 'available'
            ? copy.common.available
            : edition.status === 'experimental'
              ? copy.common.experimental
              : edition.statusLabel;

        if (release) {
          const isoSize = formatIsoSize(release.sizeBytes);

          return (
            <section id={edition.id} class="border border-border bg-surface-soft p-8 sm:p-10">
              <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
                <div>
                  <p class="label-mono font-medium text-accent">
                    {edition.name} · {statusLabel}
                  </p>
                  <h2 class="mt-3 text-2xl font-semibold tracking-tight text-text sm:text-3xl">
                    {releaseCopy.title}
                  </h2>
                  <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">
                    {releaseCopy.summary}
                  </p>
                  {releaseCopy.direction && (
                    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-text-muted">
                      {releaseCopy.direction}
                    </p>
                  )}
                  <dl class="mt-8 grid gap-4 border-t border-border pt-6 sm:grid-cols-2 lg:grid-cols-4">
                    <div>
                      <dt class="text-sm text-text-muted">{copy.common.edition}</dt>
                      <dd class="mt-1 font-mono text-sm font-medium text-text">
                        {edition.name}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-sm text-text-muted">{copy.common.series}</dt>
                      <dd class="mt-1 font-mono text-sm font-medium text-text">
                        {release.series}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-sm text-text-muted">{copy.common.version}</dt>
                      <dd class="mt-1 font-mono text-sm font-medium text-text">
                        {release.version}
                      </dd>
                    </div>
                    {release.publishedAt && (
                      <div>
                        <dt class="text-sm text-text-muted">{copy.common.published}</dt>
                        <dd class="mt-1 font-mono text-sm font-medium text-text">
                          {formatPublicationDate(release.publishedAt)}
                        </dd>
                      </div>
                    )}
                  </dl>
                  <p class="mt-3 break-all font-mono text-xs text-text-muted">
                    {copy.common.tag} · {release.tag}
                  </p>
                  <div class="mt-8 border-t border-border pt-6">
                    <p class="label-mono text-accent">{shared.releaseImage}</p>
                    {release.isoUrl && release.isoFileName && (
                      <a
                        href={release.isoUrl}
                        class="mt-2 block break-all font-mono text-sm text-text underline decoration-border underline-offset-4 hover:decoration-text-muted"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {release.isoFileName}
                        <span class="sr-only"> {shared.opensNewTab}</span>
                      </a>
                    )}
                    <p class="mt-2 text-sm text-text-muted">
                      {validatedConfiguration.architecture}
                      {isoSize ? ` · ${isoSize} ${shared.bytes}` : ''}
                    </p>
                    {release.sha256 && (
                      <p class="mt-3 text-xs leading-relaxed text-text-muted">
                        {copy.common.sha256}
                        <code class="ml-1 break-all font-mono text-[0.7rem] text-text">
                          {release.sha256}
                        </code>
                      </p>
                    )}
                  </div>
                  {releaseCopy.highlights.length > 0 && (
                    <ul class="mt-8 space-y-2 border-t border-border pt-6 text-sm leading-relaxed text-text-muted">
                      {releaseCopy.highlights.map((item) => (
                        <li class="flex gap-2">
                          <span class="font-mono text-accent" aria-hidden="true">
                            ·
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  )}
                  {releaseCopy.evaluationNotice && (
                    <p class="mt-6 text-sm leading-relaxed text-text-muted">
                      {releaseCopy.evaluationNotice}
                    </p>
                  )}
                </div>
                <div class="flex flex-col items-stretch gap-3 lg:items-end lg:pb-1">
                  {release.isoUrl && release.isoFileName && (
                    <>
                      <ActionLink href={release.isoUrl} external>
                        {copy.common.downloadIso}
                      </ActionLink>
                      <p class="font-mono text-center text-xs text-text-muted lg:text-right">
                        {copy.common.directDownload} · {release.isoFileName}
                      </p>
                    </>
                  )}
                  <ActionLink href={release.verifyGuideHref} variant="ghost" external>
                    {copy.common.verificationGuide}
                  </ActionLink>
                  {release.releasePageHref && (
                    <ActionLink href={release.releasePageHref} variant="ghost" external>
                      {copy.common.releaseNotes}
                    </ActionLink>
                  )}
                </div>
              </div>
            </section>
          );
        }

        return (
          <section id={edition.id} class="border border-border bg-surface-soft p-8 sm:p-10">
            <p class="label-mono font-medium text-accent">
              {edition.name} · {statusLabel}
            </p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-text sm:text-3xl">
              {edition.productName}
            </h2>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">
              {editionCopy?.statusDetail ?? edition.statusDetail}
            </p>
            {editionCopy?.audience && (
              <p class="mt-4 max-w-2xl text-sm leading-relaxed text-text-muted">{editionCopy.audience}</p>
            )}
          </section>
        );
      })
    }

    <section>
      <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
        {formatCopy(downloads.whatsNewHeading, { edition: DISTRIBUTION.editionName })}
      </h2>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">
        {defaultReleaseCopy.whatsNew.intro}
      </p>
      <ul class="mt-6 max-w-2xl space-y-2 text-sm leading-relaxed text-text-muted">
        {
          defaultReleaseCopy.whatsNew.improvements.map((item) => (
            <li class="flex gap-2">
              <span class="font-mono text-accent" aria-hidden="true">
                ·
              </span>
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-text-muted">
        {defaultReleaseCopy.whatsNew.closing}
      </p>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-text-muted">
        {defaultReleaseCopy.evaluationNotice}
      </p>
    </section>

    <section class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {downloads.configurationHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {formatCopy(downloads.configurationBody, {
            edition: DISTRIBUTION.editionName,
            series: DISTRIBUTION.series,
            stage: copy.common.alpha,
          })}
        </p>
        <table class="mt-8 w-full border-t border-border text-sm">
          <caption class="sr-only">{downloads.configurationCaption}</caption>
          <tbody>
            {
              configuration.map((row) => (
                <tr class="border-b border-border">
                  <th scope="row" class="py-3 pr-6 text-left font-normal text-text-muted">
                    {row.label}
                  </th>
                  <td class="py-3 text-right font-mono text-[0.8125rem] text-text">
                    {row.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
          {downloads.validationHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {downloads.validationBody}
        </p>
        <ul class="mt-8 grid gap-x-8 gap-y-2 border-t border-border pt-6 text-sm leading-relaxed text-text-muted sm:grid-cols-2">
          {
            validatedConfiguration.results.map((result) => (
              <li class="flex gap-2">
                <span class="font-mono text-accent" aria-hidden="true">✓</span>
                {result}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="verification">
      <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
        {downloads.verificationHeading}
      </h2>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">
        {downloads.verificationBody}
      </p>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-text-muted">
        {shared.verificationGuideIntro} <a
          href={artifacts.verifyGuide.href}
          class="text-text underline decoration-border underline-offset-4 hover:decoration-text-muted"
          target="_blank"
          rel="noopener noreferrer"
        >{copy.common.verificationGuide}<span class="sr-only"> {shared.opensNewTab}</span></a>.
      </p>
    </section>

    <section id="installation" class="grid gap-8 md:grid-cols-2">
      <div class="border border-border bg-surface-soft p-8 sm:p-10">
        <h2 class="text-xl font-semibold tracking-tight text-text">{downloads.installationHeading}</h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {downloads.installationBody}
        </p>
        <div class="mt-6">
          <ActionLink href={DISTRIBUTION.artifacts.installGuide.href} external>
            {shared.installationGuide}
          </ActionLink>
        </div>
      </div>

      <div class="border border-border bg-surface-soft p-8 sm:p-10">
        <h2 class="text-xl font-semibold tracking-tight text-text">
          {downloads.beforeDiskHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {downloads.beforeDiskBody}
        </p>
        <div class="mt-6">
          <ActionLink href={localizedPath(locale, 'gallery')} variant="secondary">
            {downloads.gallery}
          </ActionLink>
        </div>
      </div>
    </section>

    {
      editionsWithHistory.map((edition) => (
        <section>
          <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
            {edition.name} · {shared.releaseHistory}
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-muted">
            {downloads.historyBody}
          </p>
          <ul class="mt-8 divide-y divide-border border-y border-border">
            {edition.releaseHistory.map((release) => (
              <li class="flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
                  <p class="font-medium text-text">
                    {getReleaseCopy(locale, release.editionId, release.version).label}
                  </p>
                  <p class="font-mono text-sm text-text-muted">{release.version}</p>
                  {release.publishedAt && (
                    <p class="font-mono text-sm text-text-muted">
                      {formatPublicationDate(release.publishedAt)}
                    </p>
                  )}
                </div>
                {release.isCurrent ? (
                  <p class="label-mono text-accent">{copy.common.currentRelease}</p>
                ) : release.href ? (
                  <ActionLink href={release.href} variant="ghost" external>
                    {copy.common.openRelease}
                  </ActionLink>
                ) : null}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</Layout>
