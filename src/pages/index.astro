---
import Layout from '../layouts/Layout.astro';
import ActionLink from '../components/site/ActionLink.astro';
import CapabilityIndex from '../components/site/CapabilityIndex.astro';
import DownloadPanel from '../components/site/DownloadPanel.astro';
import EditionOverview from '../components/site/EditionOverview.astro';
import ProjectSupport from '../components/site/ProjectSupport.astro';
import Screenshot from '../components/site/Screenshot.astro';
import firstBoot from '../assets/screenshots/first-boot.png';
import terminalFastfetch from '../assets/screenshots/terminal-fastfetch.png';
import {
  DISTRIBUTION,
  PUBLIC_EDITIONS,
  SOFTWARE_APPLICATION_JSONLD,
} from '../consts';
import {
  getCopy,
  getLocale,
  localizedPath,
  MEDIA_COPY,
  formatCopy,
  type Locale,
} from '../i18n';

const editionNames = PUBLIC_EDITIONS.map((edition) => edition.name).join(' · ');
const availableEditions = PUBLIC_EDITIONS.filter(
  (edition) => edition.status === 'available',
);
export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const home = copy.home;
const media = MEDIA_COPY[locale];
---

<Layout
  locale={locale}
  title={copy.meta.index.title}
  description={copy.meta.index.description}
  image={terminalFastfetch}
  imageAlt={media.homeTerminalAlt}
  structuredData={[
    {
      ...SOFTWARE_APPLICATION_JSONLD,
      description: copy.meta.index.description,
      inLanguage: locale,
    },
  ]}
>
  <section class="border-b border-border bg-surface-inverse text-text-inverse">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14 lg:py-24">
      <div>
        <p class="label-mono font-medium text-accent-soft">
          {formatCopy(home.eyebrow, { editions: editionNames })}
        </p>
        <h1 class="display-serif mt-4 text-5xl leading-none text-text-inverse sm:text-6xl">
          {DISTRIBUTION.name}
        </h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-text-inverse/85">
          {copy.product.tagline}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ActionLink href="#editions" variant="accent">
            {home.editionsEyebrow}
          </ActionLink>
          <ActionLink
            href={localizedPath(locale, 'gallery')}
            variant="secondary"
            class="border-text-inverse/25 bg-transparent text-text-inverse hover:border-text-inverse/50 hover:bg-text-inverse/10"
          >
            {copy.nav.gallery}
          </ActionLink>
        </div>
        <p class="mt-8 font-mono text-xs leading-relaxed text-text-inverse/75">
          {availableEditions.length > 0
            ? formatCopy(home.available, {
                editions: availableEditions.map((edition) => edition.name).join(' · '),
              })
            : home.editionsEyebrow}
          <br />
          <a
            href={localizedPath(locale, 'downloads')}
            class="underline decoration-text-inverse/60 underline-offset-4 hover:text-text-inverse"
          >{home.downloadVerify}</a>
        </p>
      </div>

      <Screenshot
        image={terminalFastfetch}
        alt={media.homeTerminalAlt}
        caption={formatCopy(media.homeTerminalCaption, {
          name: DISTRIBUTION.name,
          release: DISTRIBUTION.release,
        })}
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 1024px) 100vw, 40rem"
        captionClass="text-text-inverse/75"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14">
      <div class="lg:order-2">
        <p class="label-mono font-medium text-accent">{home.whatItIs}</p>
        <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
          {home.whatItIsHeading}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-text-muted sm:text-lg">
          {home.whatItIsBody}
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-muted sm:text-lg">
          {home.whatItIsRule}
        </p>
        <p class="mt-6">
          <ActionLink href={localizedPath(locale, 'philosophy')} variant="ghost">
            {copy.nav.philosophy} →
          </ActionLink>
        </p>
      </div>
      <Screenshot
        image={firstBoot}
        alt={media.homeFirstBootAlt}
        caption={media.homeFirstBootCaption}
        class="lg:order-1"
        sizes="(max-width: 1024px) 100vw, 40rem"
      />
    </div>
  </section>

  <section id="editions" class="border-y border-border bg-surface-soft">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="label-mono font-medium text-accent">{home.editionsEyebrow}</p>
        <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
          {home.editionsHeading}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {home.editionsIntro}
        </p>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {formatCopy(home.editionsSeries, { series: DISTRIBUTION.series })}
        </p>
      </div>
      <EditionOverview locale={locale} class="mt-12" />
      <p class="mt-8 text-sm text-text-muted">
        <ActionLink href={localizedPath(locale, 'downloads')} variant="ghost">
          {copy.common.downloads} →
        </ActionLink>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="max-w-2xl">
      <p class="label-mono font-medium text-accent">{home.capabilitiesEyebrow}</p>
      <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
        {home.capabilitiesHeading}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted">
        {formatCopy(home.capabilitiesIntro, { count: copy.product.capabilities.length })}
      </p>
    </div>
    <CapabilityIndex locale={locale} class="mt-12" />
    <p class="mt-6 text-sm text-text-muted">
      <ActionLink href={localizedPath(locale, 'engineering')} variant="ghost">
        {copy.nav.engineering} →
      </ActionLink>
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-14">
      <div>
        <p class="label-mono font-medium text-accent">{home.localAiEyebrow}</p>
        <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
          {home.localAiHeading}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {home.localAiIntro}
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {home.localAiOwnership}
        </p>
      </div>
      <ul class="divide-y divide-border border-y border-border text-sm leading-relaxed text-text-muted">
        {home.localAiList.map((item) => <li class="py-3">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-surface-soft">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:py-16">
      <DownloadPanel locale={locale} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="max-w-2xl">
      <p class="label-mono font-medium text-accent">{home.continueEyebrow}</p>
      <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
        {home.continueHeading}
      </h2>
    </div>
    <nav aria-label={home.continueHeading} class="mt-10 border-t border-border">
      {
        home.continueItems.map((item, i) => (
          <a
            href={localizedPath(locale, item.page === 'index' ? '' : item.page)}
            class="group grid gap-x-8 gap-y-1 border-b border-border py-5 transition-colors hover:bg-surface-soft sm:grid-cols-[4rem_12rem_1fr_auto] sm:items-baseline"
          >
            <span class="font-mono text-sm text-text-muted/60" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-base font-semibold tracking-tight text-text">
              {item.title}
            </span>
            <span class="text-sm leading-relaxed text-text-muted">{item.description}</span>
            <span
              class="hidden text-sm font-medium text-accent transition-transform group-hover:translate-x-0.5 sm:inline"
              aria-hidden="true"
            >
              {copy.common.continueArrow}
            </span>
          </a>
        ))
      }
    </nav>
  </section>

  <ProjectSupport locale={locale} />
</Layout>
