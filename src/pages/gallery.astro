---
import Layout from '../layouts/Layout.astro';
import ActionLink from '../components/site/ActionLink.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Screenshot from '../components/site/Screenshot.astro';
import firstBoot from '../assets/screenshots/first-boot.png';
import terminalFastfetch from '../assets/screenshots/terminal-fastfetch.png';
import welcomeHandbook from '../assets/screenshots/welcome-handbook.png';
import welcomeYourSystem from '../assets/screenshots/welcome-your-system.png';
import installerPartitions from '../assets/screenshots/installer-partitions.png';
import fileManager from '../assets/screenshots/file-manager.png';
import settingsManager from '../assets/screenshots/settings-manager.png';
import applicationsMenu from '../assets/screenshots/applications-menu.png';
import { DISTRIBUTION } from '../consts';
import { formatCopy, getCopy, getLocale, localizedPath, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const gallery = copy.gallery;
---

<Layout
  locale={locale}
  title={copy.meta.gallery.title}
  description={copy.meta.gallery.description}
  image={firstBoot}
>
  <PageHeader
    eyebrow={gallery.eyebrow}
    title={gallery.heading}
    lead={formatCopy(gallery.lead, {
      name: DISTRIBUTION.name,
      release: DISTRIBUTION.release,
    })}
  />

  <article class="mx-auto max-w-5xl space-y-16 px-6 py-16 sm:space-y-20 sm:py-20">
    <section>
      <Screenshot
        image={firstBoot}
        alt={gallery.alts[0]}
        label="01"
        caption={gallery.captions[0]}
        loading="eager"
        fetchpriority="high"
      />
    </section>

    <section>
      <Screenshot
        image={terminalFastfetch}
        alt={gallery.alts[1]}
        label="02"
        caption={formatCopy(gallery.captions[1], {
          name: DISTRIBUTION.name,
          release: DISTRIBUTION.release,
          series: DISTRIBUTION.series,
        })}
      />
    </section>

    <section>
      <div class="mb-8 max-w-xl">
        <p class="label-mono font-medium text-accent">{gallery.firstSessionEyebrow}</p>
        <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
          {gallery.firstSessionHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {gallery.firstSessionBody}
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
        <Screenshot
          image={welcomeHandbook}
          alt={gallery.alts[2]}
          label="03"
          caption={gallery.captions[2]}
          sizes="(max-width: 1024px) 100vw, 30rem"
        />
        <Screenshot
          image={welcomeYourSystem}
          alt={gallery.alts[3]}
          label="04"
          caption={gallery.captions[3]}
          sizes="(max-width: 1024px) 100vw, 30rem"
        />
      </div>
    </section>

    <section>
      <Screenshot
        image={installerPartitions}
        alt={gallery.alts[4]}
        label="05"
        caption={gallery.captions[4]}
        class="mx-auto max-w-3xl"
        sizes="(max-width: 1024px) 100vw, 48rem"
      />
    </section>

    <section>
      <div class="mb-8 max-w-xl">
        <p class="label-mono font-medium text-accent">{gallery.everydayEyebrow}</p>
        <h2 class="display-serif mt-3 text-2xl text-text sm:text-3xl">
          {gallery.everydayHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-muted">
          {gallery.everydayBody}
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
        <Screenshot
          image={fileManager}
          alt={gallery.alts[5]}
          label="06"
          caption={gallery.captions[5]}
          sizes="(max-width: 1024px) 100vw, 30rem"
        />
        <Screenshot
          image={settingsManager}
          alt={gallery.alts[6]}
          label="07"
          caption={gallery.captions[6]}
          sizes="(max-width: 1024px) 100vw, 30rem"
        />
      </div>
    </section>

    <section>
      <Screenshot
        image={applicationsMenu}
        alt={gallery.alts[7]}
        label="08"
        caption={gallery.captions[7]}
        class="mx-auto max-w-2xl"
        sizes="(max-width: 1024px) 100vw, 42rem"
      />
    </section>

    <section class="border-t border-border pt-10">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-center">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-text">
          {gallery.beforeInstallHeading}
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-muted">
            {gallery.beforeInstallBody}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <ActionLink href={localizedPath(locale, 'downloads')}>{gallery.downloads}</ActionLink>
        </div>
      </div>
    </section>
  </article>
</Layout>
