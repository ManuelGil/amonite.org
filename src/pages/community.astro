---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ActionLink from '../components/site/ActionLink.astro';
import PageHeader from '../components/site/PageHeader.astro';
import ProjectSupport from '../components/site/ProjectSupport.astro';
import {
  COMMUNITY_URL,
  DOWNLOAD_URL,
} from '../consts';
import workspaceImage from '../assets/img/workspace.jpg';
import { getCopy, getLocale, localizedPath, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const community = copy.community;
const channels = community.channels;
const channelLinks = [
  { href: COMMUNITY_URL, external: true },
  { href: DOWNLOAD_URL, external: true },
  { href: localizedPath(locale, 'downloads'), external: false },
];
---

<Layout
  locale={locale}
  title={copy.meta.community.title}
  description={copy.meta.community.description}
>
  <PageHeader
    eyebrow={community.eyebrow}
    title={community.heading}
    lead={community.lead}
  />

  <article class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <section class="grid gap-8 pb-16 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-14">
      <figure>
        <Image
          src={workspaceImage}
          alt={community.imageAlt}
          class="h-72 w-full object-cover object-center sm:h-80 lg:h-96"
          width={1200}
          widths={[480, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 28rem"
          quality={82}
          format="webp"
        />
        <figcaption class="mt-3 text-xs leading-relaxed text-text-muted">
          {community.imageCaption}
        </figcaption>
      </figure>
      <p class="max-w-xl text-lg leading-relaxed text-text-muted">
        {community.intro}
      </p>
    </section>

    <div class="border-t border-border">
      {
        channels.map((channel, i) => (
          <section class="grid gap-x-8 gap-y-3 border-b border-border py-8 sm:grid-cols-[4rem_14rem_1fr_auto] sm:items-start sm:py-10">
            <span class="font-mono text-sm text-text-muted/60" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 class="text-base font-semibold tracking-tight text-text">
                {channel.name}
              </h2>
              <p class="label-mono mt-1 text-accent">{channel.role}</p>
            </div>
            <p class="max-w-xl text-sm leading-relaxed text-text-muted">{channel.detail}</p>
            <ActionLink
              href={channelLinks[i].href}
              variant="secondary"
              external={channelLinks[i].external}
              class="justify-self-start sm:justify-self-end"
            >
              {channel.linkLabel}
            </ActionLink>
          </section>
        ))
      }
    </div>
  </article>

  <ProjectSupport locale={locale} />
</Layout>
