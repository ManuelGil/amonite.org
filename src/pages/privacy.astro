---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import { COMMUNITY_URL } from '../consts';
import { getCopy, getLocale, type Locale } from '../i18n';

export interface Props {
  locale?: Locale;
}

const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getCopy(locale);
const privacy = copy.legal.privacy;
const privacyCommunityLead = privacy.paragraphs[2].replace(/r\/Amonite\.?$/, '').trimEnd();
---

<Layout
  locale={locale}
  title={privacy.title}
  description={privacy.description}
>
  <PageHeader eyebrow={privacy.eyebrow} title={privacy.title} />
  <article class="mx-auto max-w-2xl px-6 py-16 sm:py-20">
    <div class="space-y-6 text-base leading-relaxed text-text-muted">
      <p>{privacy.paragraphs[0]}</p>
      <p>{privacy.paragraphs[1]}</p>
      <p>
        {privacyCommunityLead}{' '}
        <a href={COMMUNITY_URL} class="text-text underline decoration-border underline-offset-[5px] hover:decoration-text-muted">r/Amonite</a>.
      </p>
    </div>
  </article>
</Layout>
